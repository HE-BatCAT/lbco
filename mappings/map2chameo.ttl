########################################################################################
# Battery characterization techniques, for LiB and RFB
########################################################################################

lbco:calendar_ageing rdfs:subClassOf chameo:CharacterisationTechnique ;
		     rdfs:seeAlso "https://w3id.org/emmo/domain/electrochemistry#electrochemistry_c91164b8_5e56_4c94_bad1_d7ada576b0e7"^^xs:anyURI .  # class for StorageTest 
lbco:charge_test rdfs:subClassOf chameo:Chronopotentiometry . 
lbco:discharge_test rdfs:subClassOf chameo:Chronopotentiometry .
lbco:road_profile_test rdfs:subClassOf chameo:CharacterisationTechnique ;
		       rdfs:seeAlso "https://w3id.org/emmo/domain/electrochemistry#electrochemistry_dc1af38d_438e_40c2_8a68_0d631a8f46f2"^^xs:anyURI ;  # class for PowerControlledProcess
		       rdfs:comment "Not limited to constant power, power mixed with CC/CV phases can be used"^^xs:string .
lbco:duty_profile_test rdfs:subClassOf chameo:CharacterisationTechnique ;
		       rdfs:seeAlso "https://w3id.org/emmo/domain/electrochemistry#electrochemistry_dc1af38d_438e_40c2_8a68_0d631a8f46f2"^^xs:anyURI ;  # class for PowerControlledProcess
		       rdfs:comment "Not limited to constant power, power mixed with CC/CV phases can be used"^^xs:string .
lbco:cycling rdfs:subClassOf chameo:CharacterisationTechnique ;
		       rdfs:seeAlso "https://w3id.org/emmo/domain/electrochemistry#electrochemistry_435b22d4_c441_45ea_8c79_0cbec11fd287"^^xs:anyURI . # class for CyclingTest

lbco:bet_measurement rdfs:subClassOf chameo:BrunauerEmmettTellerMethod . # equivalentClass, we use subClassOf for simplicity
lbco:cyclic_voltametry rdfs:subClassOf chameo:CyclicVoltammetry .  # equivalentClass, we use subClassOf for simplicity
lbco:eis_test rdfs:subClassOf chameo:ElectrochemicalImpedanceSpectroscopy .  # equivalentClass, we use subClassOf for simplicity
lbco:gitt_test rdfs:subClassOf chameo:GalvanostaticIntermittentTitrationTechnique .  # equivalentClass, we use subClassOf for simplicity
lbco:hppc_test rdfs:subClassOf chameo:HPPC .  # equivalentClass, we use subClassOf for simplicity
lbco:porosimetry rdfs:subClassOf chameo:Porosimetry .  # equivalentClass, we use subClassOf for simplicity
lbco:raman_spectrometry rdfs:subClassOf chameo:RamanSpectroscopy .  # equivalentClass, we use subClassOf for simplicity
lbco:sem_technique rdfs:subClassOf chameo:ScanningElectronMicroscopy .  # equivalentClass, we use subClassOf for simplicity
lbco:XPS_technique rdfs:subClassOf chameo:XpsVariableKinetic .  # equivalentClass, we use subClassOf for simplicity

# skos:relatedMatch # NB: this will cause punning (creating individuals with same name as the classes)
